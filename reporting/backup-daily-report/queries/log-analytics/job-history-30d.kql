// 30-day job history from vault diagnostic logs (resource-specific tables).
// Requires: vault Diagnostic settings -> Log Analytics, destination table "Resource specific",
// categories CoreAzureBackup and AddonAzureBackupJobs.
AddonAzureBackupJobs
| where TimeGenerated > ago(30d)
| where JobOperation == "Backup"
| summarize arg_max(TimeGenerated, *) by JobUniqueId
| join kind=leftouter (
    CoreAzureBackup
    | where OperationName == "BackupItem"
    | summarize arg_max(TimeGenerated, BackupItemFriendlyName, VaultName) by BackupItemUniqueId
  ) on BackupItemUniqueId
| project StartET = datetime_utc_to_local(JobStartDateTime, "America/New_York"),
          VaultName, Item = BackupItemFriendlyName, JobStatus, JobFailureCode,
          DurationMin = round(JobDurationInSecs / 60.0, 1)
| order by StartET desc
