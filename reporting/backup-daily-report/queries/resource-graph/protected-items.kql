// Every item protected in a Recovery Services vault, with a simple health rating.
// Stale = no successful backup in the last 26 hours (adjust for weekly-only policies).
recoveryservicesresources
| where type =~ 'microsoft.recoveryservices/vaults/backupfabrics/protectioncontainers/protecteditems'
| extend vaultName       = tostring(split(id, '/')[8]),
         item            = tostring(properties.friendlyName),
         workload        = tostring(properties.workloadType),
         policy          = tostring(properties.policyName),
         protectionState = tostring(coalesce(properties.protectionState, properties.currentProtectionState)),
         lastStatus      = tostring(properties.lastBackupStatus),
         lastBackup      = todatetime(properties.lastBackupTime)
| extend health = case(
        protectionState in~ ('ProtectionStopped', 'SoftDeleted'), 'Stopped',
        lastStatus =~ 'Failed' or protectionState =~ 'ProtectionError', 'Failed',
        isnull(lastBackup) or lastBackup < ago(26h), 'Stale',
        'Healthy')
| project subscriptionId, resourceGroup, vaultName, item, workload, policy, health, protectionState, lastStatus, lastBackup
| order by health asc, vaultName asc, item asc
